{
  "manifest_version": 3,
  "name": "GOBLIN - YouTube Learn Mode",
  "version": "1.0.0",
  "description": "Turns any YouTube video into an interactive course with notes, quizzes, and flashcards.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Learn Mode"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/index.tsx"]
    }
  ],
  "background": {
    "service_worker": "src/background/index.ts"
  }
}
